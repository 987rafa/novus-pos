# ── NOVUS POS — variables de entorno ──────────────────────────
# Base de datos (SQLite para desarrollo, PostgreSQL en Docker/producción)
DATABASE_URL=sqlite:///./novus-pos.db
# DATABASE_URL=postgresql+psycopg://novus:novus@localhost:5432/novus

# Clave para firmar los tokens JWT (mínimo 32 caracteres) — cámbiala en producción
SECRET_KEY=dev-secret-change-me-please-0123456789abcdef

# Minutos de validez del token (12 h por defecto)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# IVA aplicado a las ventas (0.19 = 19 % Colombia)
TAX_RATE=0.19

# Orígenes permitidos para el frontend (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sembrar datos demo al arrancar (usuarios, productos, ventas)
SEED_ON_STARTUP=false

# Primer administrador (dueño de la instalación): se crea al arrancar si la base no tiene ninguno.
# En cada instalación solo puede existir UN administrador; los cajeros se crean desde la app
# y quedan vinculados a él. Cámbialo antes de usarlo en serio.
# ADMIN_EMAIL=admin@novus.dev
# ADMIN_PASSWORD=Admin123*
# ADMIN_NAME=Administrador

# Carpeta donde se guardan las fotos de productos (en Docker va montada como volumen)
# UPLOADS_DIR=uploads

# Clave para canales externos de pedidos (WhatsApp / web) — se envía en el header X-API-Key.
# Vacía = la creación externa de pedidos queda deshabilitada.
# ORDERS_API_KEY=pedidos-demo-key
